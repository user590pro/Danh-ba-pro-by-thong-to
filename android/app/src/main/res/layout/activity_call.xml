<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Top Info Section -->
    <LinearLayout
        android:id="@+id/layoutTopInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- App branding watermark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Danh Bạ Pro by Thông Tô"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Caller Avatar -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_circle_avatar">

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Caller Name -->
        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Đang kết nối..."
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Caller Phone Number -->
        <TextView
            android:id="@+id/tvCallerNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="16sp" />

        <!-- Call Status / Chronometer -->
        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Đang gọi..."
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- In-Call Middle Controls (Loa, Tắt tiếng, Bàn phím) -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layoutBottomActions"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Speaker Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="Loa ngoài"
                android:src="@drawable/ic_speaker" />

            <TextView
                android:id="@+id/tvSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Loa ngoài"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mute Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="Tắt tiếng"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/tvMuteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tắt tiếng"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Keypad Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnKeypad"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="Bàn phím"
                android:src="@drawable/ic_dialpad" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bàn phím"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions Section -->
    <FrameLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp">

        <!-- Active / Outgoing: End Call Button -->
        <LinearLayout
            android:id="@+id/layoutActiveActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEndCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_red"
                android:contentDescription="Kết thúc cuộc gọi"
                android:src="@drawable/ic_call_end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kết thúc"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Incoming Call Actions: Decline & Answer -->
        <LinearLayout
            android:id="@+id/layoutIncomingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Decline -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnDecline"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_circle_red"
                    android:contentDescription="Từ chối"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Từ chối"
                    android:textColor="#EF4444"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Answer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnAnswer"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_circle_green"
                    android:contentDescription="Trả lời"
                    android:src="@drawable/ic_call_answer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Trả lời"
                    android:textColor="#22C55E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- DTMF Keypad Modal / Overlay -->
    <LinearLayout
        android:id="@+id/layoutDtmf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172AF0"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDtmfDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:textColor="#F8FAFC"
            android:textSize="32sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/gridDtmf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:rowCount="4">

            <!-- Buttons 1 to 9, *, 0, # added programmatically or via text -->
        </GridLayout>

        <Button
            android:id="@+id/btnHideDtmf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_circle_btn"
            android:paddingHorizontal="24dp"
            android:text="Ẩn bàn phím"
            android:textColor="#F8FAFC" />
    </LinearLayout>

</RelativeLayout>
